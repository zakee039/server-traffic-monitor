server {
    listen @PORT@ ssl http2;
    listen [::]:@PORT@ ssl http2;
    server_name @DOMAIN@;

    root /var/www/server-traffic-monitor;
    index index.html;
    autoindex off;
    server_tokens off;

    ssl_certificate     /etc/nginx/ssl/server-traffic-monitor/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/server-traffic-monitor/privkey.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control "no-cache";

    location = /data.json {
        limit_except GET { deny all; }
        try_files $uri =404;
        add_header Cache-Control "no-store, max-age=0";
        default_type application/json;
    }

    location ~ ^/api/admin/(refresh|adjust|package)$ {
        auth_basic "Server Traffic Monitor";
        auth_basic_user_file /etc/nginx/server-traffic-monitor.htpasswd;

        client_max_body_size 4k;
        client_body_buffer_size 4k;
        root /var/lib/server-traffic-monitor;

        dav_methods PUT;
        create_full_put_path on;
        dav_access user:rw group:rw all:r;

        limit_except PUT { deny all; }
        add_header Cache-Control "no-store";
    }

    location = / {
        limit_except GET { deny all; }
        try_files /index.html =404;
    }

    location / {
        limit_except GET { deny all; }
        try_files $uri =404;
    }

    location ~ /\. {
        deny all;
    }
}
